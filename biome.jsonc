{
  // Biome is the linter and formatter (fleet convention). Indentation matches .editorconfig.
  "$schema": "https://biomejs.dev/schemas/2.6.7/schema.json",
  "files": { "includes": ["**", "!node_modules", "!sounds"] },
  "formatter": { "indentStyle": "space", "indentWidth": 2, "lineWidth": 160 },
  "javascript": { "formatter": { "quoteStyle": "single", "arrowParentheses": "asNeeded" } },
  "linter": { "enabled": true }
}
